{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klepai",
  "version": "0.0.1",
  "identifier": "com.crystalplatforms.klepai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Klepai",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/CrystalPlatforms/klepai/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2RTI1QUM5RTcyMEU1MzEKUldReDVTRG55VnJpQm9jb2JuYVUrNm8wbTgzaDI5NUxKZCt0WTlUazFBUWN4N3M3N3lGMjgrOUUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
